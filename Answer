5. from graphics import GraphWin, Point, Line, Text, Entry, Rectangle

def run_interactive_grapher():
    win = GraphWin("Interactive Logistic Grapher", 700, 500)
    win.setBackground("white")
    
    win.setCoords(-15, -0.2, 115, 1.2)
    
    Text(Point(10, 1.1), "Initial X:").draw(win)
    input_x = Entry(Point(25, 1.1), 5)
    input_x.setText("0.2")
    input_x.draw(win)
    
    Text(Point(45, 1.1), "Growth r:").draw(win)
    input_r = Entry(Point(60, 1.1), 5)
    input_r.setText("3.6")
    input_r.draw(win)
    
    button = Rectangle(Point(80, 1.05), Point(100, 1.15))
    button.setFill("lightgray")
    button.draw(win)
    button_text = Text(Point(90, 1.1), "Graph")
    button_text.draw(win)
  
    Line(Point(0, 0), Point(100, 0)).draw(win)
    Line(Point(0, 0), Point(0, 1)).draw(win)
    Text(Point(-5, 0.5), "X value").draw(win)
    Text(Point(50, -0.08), "Time").draw(win)
  
    graph_elements = []

    while True:
        click_pt = win.getMouse()
        cx, cy = click_pt.getX(), click_pt.getY()
        
      
        if 80 <= cx <= 100 and 1.05 <= cy <= 1.15:
            if button_text.getText() == "Exit":
                break # Terminate application loop
                
           
            for element in graph_elements:
                element.undraw()
            graph_elements.clear()
            
           
            try:
                x_val = float(input_x.getText())
                r = float(input_r.getText())
            except ValueError:
                continue # Ignore clicks if input is corrupted/malformed text
            
        
            prev_pt = Point(0, x_val)
            for t in range(1, 101):
                x_val = r * x_val * (1 - x_val)
                curr_pt = Point(t, x_val)
                
                segment = Line(prev_pt, curr_pt)
                segment.setOutline("blue")
                segment.draw(win)
                graph_elements.append(segment)
                
               
                dot = Point(t, x_val)
                dot.setOutline("red")
                dot.draw(win)
                graph_elements.append(dot)
                
                prev_pt = curr_pt
                
           
            button_text.setText("Exit")
            button.setFill("salmon")

    win.close()

if __name__ == "__main__":
    run_interactive_grapher()

