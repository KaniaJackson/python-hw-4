1.import math
from graphics import GraphWin, Polygon, Point

def draw_polygon():
    n = int(input("Enter the number of sides: "))
    radius = float(input("Enter the radius of the polygon: "))
    
    win_size = 500
    win = GraphWin("Regular Polygon", win_size, win_size)
    center_x = win_size / 2
    center_y = win_size / 2
    
    angle_step = 360 / n
    vertices = []
    
    for i in range(n):
        deg = i * angle_step
        rad = math.radians(deg)
  
        x = center_x + radius * math.cos(rad)
        y = center_y - radius * math.sin(rad)
        
        vertices.append(Point(x, y))
        
    poly = Polygon(vertices)
    poly.draw(win)
    
    win.getMouse()
    win.close()

if __name__ == "__main__":
    draw_polygon()
2. import math
from graphics import GraphWin, Polygon, Point

def draw_flat_polygon():
    n = int(input("Enter the number of sides: "))
    radius = float(input("Enter the radius of the polygon: "))
    
    win_size = 500
    win = GraphWin("Rotated Regular Polygon", win_size, win_size)
    center_x = win_size / 2
    center_y = win_size / 2 
    angle_step = 360 / n
    offset = 90 + (180 / n)
    vertices = []
    
    for i in range(n):
        deg = (i * angle_step) + offset
        rad = math.radians(deg)
        
        x = center_x + radius * math.cos(rad)
        y = center_y - radius * math.sin(rad)
        
        vertices.append(Point(x, y))
        
    poly = Polygon(vertices)
    poly.draw(win)
    
    win.getMouse()
    win.close()

if __name__ == "__main__":
    draw_flat_polygon()
3. from graphics import GraphWin, Point, Line, Text

def graph_logistic_points():
    # Prompt for user inputs
    x_val = float(input("Enter initial value (0 to 1): "))
    r = float(input("Enter growth rate r (e.g., 3.5): "))
    
    win = GraphWin("Logistic Function - Points", 600, 400)
    win.setCoords(-5, -0.1, 105, 1.1)
    
    Line(Point(0, 0), Point(100, 0)).draw(win) # X axis
    Line(Point(0, 0), Point(0, 1)).draw(win)   # Y axis
    Text(Point(50, -0.05), "Time (Iterations)").draw(win)
    Text(Point(-3, 0.5), "Y").draw(win)
    
    Point(0, x_val).draw(win)
    
    for t in range(1, 101):
        x_val = r * x_val * (1 - x_val)
        pt = Point(t, x_val)
        pt.draw(win)
        
    win.getMouse()
    win.close()

if __name__ == "__main__":
    graph_logistic_points()

